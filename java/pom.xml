<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hrms</groupId>
  <artifactId>hrms-add-employee-tests</artifactId>
  <version>1.0.0</version>
  <name>HRMS Add Employee - Playwright Java tests</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <playwright.version>1.48.0</playwright.version>
    <junit.version>5.11.3</junit.version>
    <!-- Tags excluded from a normal `mvn test`. -->
    <excludedGroups>login,real-submit</excludedGroups>
    <groups></groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <groups>${groups}</groups>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <!-- The demo API rate-limits (HTTP 429) on rapid reloads: run one test at a time. -->
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <trimStackTrace>true</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <!-- `mvn exec:java -Dexec.args="install chromium"` installs the browser. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.microsoft.playwright.CLI</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn test -Plogin : opens a browser so you can sign in; saves the session. -->
      <id>login</id>
      <properties>
        <groups>login</groups>
        <excludedGroups></excludedGroups>
      </properties>
    </profile>
    <profile>
      <!-- mvn test -Preal-submit : CREATES A REAL EMPLOYEE. -->
      <id>real-submit</id>
      <properties>
        <groups>real-submit</groups>
        <excludedGroups></excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
