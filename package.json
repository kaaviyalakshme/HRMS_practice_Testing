{
  "name": "hrms-practice-testing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "login": "playwright test --project=setup --headed",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:real-submit": "cross-env ALLOW_REAL_SUBMIT=1 playwright test tests/add-employee/99-real-submission.spec.ts --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  }
}
